{
  "schemaVersion": "1.0.0",
  "name": "system",
  "version": "1.0.0",
  "description": "@i18n:package.description",
  "adapters": [
    {
      "name": "scheduler",
      "entrypoint": "adapters.container",
      "capabilities": [
        "workflow.container",
        "system.loop_middleware",
        "system.case_middleware",
        "system.input_generator",
        "system.upload_test"
      ]
    }
  ],
  "python": {
    "requires": ">=3.10,<3.12",
    "dependencies": []
  },
  "nodes": [
    {
      "type": "workflow.container",
      "role": "container",
      "status": "published",
      "category": "@i18n:nodes.workflow.container.category",
      "label": "@i18n:nodes.workflow.container.label",
      "description": "@i18n:nodes.workflow.container.description",
      "adapter": "scheduler",
      "handler": "container",
      "config": {},
      "schema": {
        "parameters": {
          "type": "object",
          "properties": {
            "__container": {
              "type": "object",
              "properties": {
                "subgraphId": {
                  "type": "string",
                  "description": "Identifier of the subgraph definition to run."
                },
                "timeoutSeconds": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Optional runtime timeout for the nested workflow."
                }
              },
              "required": [
                "subgraphId"
              ],
              "additionalProperties": true
            }
          },
          "required": [
            "__container"
          ],
          "additionalProperties": true
        },
        "results": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "ui": {
        "widgets": [
          {
            "key": "subgraph",
            "label": "@i18n:nodes.workflow.container.widgets.subgraph.label",
            "component": "subgraph-picker",
            "binding": {
              "path": "/parameters/__container/subgraphId",
              "mode": "write"
            },
            "options": {
              "placeholder": "Choose subgraph..."
            }
          },
          {
            "key": "openSubgraph",
            "label": "@i18n:nodes.workflow.container.widgets.openSubgraph.label",
            "component": "subgraph-jump",
            "binding": {
              "path": "/parameters/__container/subgraphId",
              "mode": "read"
            },
            "options": {
              "buttonLabel": "Jump to subgraph"
            }
          },
          {
            "key": "timeoutSeconds",
            "label": "@i18n:nodes.workflow.container.widgets.timeoutSeconds.label",
            "component": "number",
            "binding": {
              "path": "/parameters/__container/timeoutSeconds",
              "mode": "two_way"
            },
            "options": {
              "min": 1
            }
          }
        ]
      }
    },
    {
      "type": "system.loop_middleware",
      "role": "middleware",
      "status": "published",
      "category": "@i18n:nodes.system.loop_middleware.category",
      "label": "@i18n:nodes.system.loop_middleware.label",
      "description": "@i18n:nodes.system.loop_middleware.description",
      "adapter": "scheduler",
      "handler": "loop_middleware",
      "config": {},
      "schema": {
        "parameters": {
          "type": "object",
          "properties": {
            "times": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "description": "Number of times to invoke the next handler."
            },
            "delayMs": {
              "type": "integer",
              "minimum": 0,
              "description": "Optional delay between iterations (milliseconds)."
            },
            "stopOnError": {
              "type": "boolean",
              "default": true,
              "description": "Stop looping when an iteration raises an error."
            }
          },
          "required": [
            "times"
          ],
          "additionalProperties": true
        },
        "results": {
          "type": "object",
          "properties": {
            "iterations": {
              "type": "integer",
              "description": "Total iterations attempted."
            },
            "succeeded": {
              "type": "integer",
              "description": "Number of successful iterations."
            },
            "failures": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "iteration": {
                    "type": "integer"
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "iteration",
                  "error"
                ]
              }
            },
            "responses": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Raw responses from each iteration."
            }
          },
          "additionalProperties": true
        }
      },
      "ui": {
        "inputPorts": [
          {
            "key": "times",
            "label": "@i18n:nodes.system.loop_middleware.inputPorts.times.label",
            "binding": {
              "path": "/parameters/times",
              "mode": "write"
            }
          },
          {
            "key": "delayMs",
            "label": "@i18n:nodes.system.loop_middleware.inputPorts.delayMs.label",
            "binding": {
              "path": "/parameters/delayMs",
              "mode": "write"
            }
          },
          {
            "key": "stopOnError",
            "label": "@i18n:nodes.system.loop_middleware.inputPorts.stopOnError.label",
            "binding": {
              "path": "/parameters/stopOnError",
              "mode": "write"
            }
          }
        ],
        "outputPorts": [
          {
            "key": "iterations",
            "label": "@i18n:nodes.system.loop_middleware.outputPorts.iterations.label",
            "binding": {
              "path": "/results/iterations",
              "mode": "read"
            }
          },
          {
            "key": "succeeded",
            "label": "@i18n:nodes.system.loop_middleware.outputPorts.succeeded.label",
            "binding": {
              "path": "/results/succeeded",
              "mode": "read"
            }
          },
          {
            "key": "failures",
            "label": "@i18n:nodes.system.loop_middleware.outputPorts.failures.label",
            "binding": {
              "path": "/results/failures",
              "mode": "read"
            }
          },
          {
            "key": "responses",
            "label": "@i18n:nodes.system.loop_middleware.outputPorts.responses.label",
            "binding": {
              "path": "/results/responses",
              "mode": "read"
            }
          }
        ],
        "widgets": [
          {
            "key": "times",
            "label": "@i18n:nodes.system.loop_middleware.widgets.times.label",
            "component": "number",
            "binding": {
              "path": "/parameters/times",
              "mode": "two_way"
            },
            "options": {
              "min": 1
            }
          },
          {
            "key": "delayMs",
            "label": "@i18n:nodes.system.loop_middleware.widgets.delayMs.label",
            "component": "number",
            "binding": {
              "path": "/parameters/delayMs",
              "mode": "two_way"
            },
            "options": {
              "min": 0
            }
          },
          {
            "key": "stopOnError",
            "label": "@i18n:nodes.system.loop_middleware.widgets.stopOnError.label",
            "component": "checkbox",
            "binding": {
              "path": "/parameters/stopOnError",
              "mode": "two_way"
            }
          },
          {
            "key": "iterations",
            "label": "@i18n:nodes.system.loop_middleware.widgets.iterations.label",
            "component": "number",
            "binding": {
              "path": "/results/iterations",
              "mode": "read"
            },
            "options": {
              "readOnly": true
            }
          }
        ]
      }
    },
    {
      "type": "system.case_middleware",
      "role": "middleware",
      "status": "published",
      "category": "@i18n:nodes.system.case_middleware.category",
      "label": "@i18n:nodes.system.case_middleware.label",
      "description": "@i18n:nodes.system.case_middleware.description",
      "adapter": "scheduler",
      "handler": "case_middleware",
      "config": {},
      "schema": {
        "parameters": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "When false, the middleware chain stops and host completes."
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": true
        },
        "results": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Evaluated flag."
            },
            "skipped": {
              "type": "boolean",
              "description": "True when the chain was short-circuited (disabled)."
            }
          },
          "additionalProperties": true
        }
      },
      "ui": {
        "inputPorts": [
          {
            "key": "enabled",
            "label": "@i18n:nodes.system.case_middleware.inputPorts.enabled.label",
            "binding": {
              "path": "/parameters/enabled",
              "mode": "write"
            }
          }
        ],
        "outputPorts": [
          {
            "key": "enabled",
            "label": "@i18n:nodes.system.case_middleware.outputPorts.enabled.label",
            "binding": {
              "path": "/results/enabled",
              "mode": "read"
            }
          },
          {
            "key": "skipped",
            "label": "@i18n:nodes.system.case_middleware.outputPorts.skipped.label",
            "binding": {
              "path": "/results/skipped",
              "mode": "read"
            }
          }
        ],
        "widgets": [
          {
            "key": "enabled",
            "label": "@i18n:nodes.system.case_middleware.widgets.enabled.label",
            "component": "checkbox",
            "binding": {
              "path": "/parameters/enabled",
              "mode": "two_way"
            }
          }
        ]
      }
    },
    {
      "type": "system.input_generator",
      "status": "published",
      "category": "@i18n:nodes.system.input_generator.category",
      "label": "@i18n:nodes.system.input_generator.label",
      "description": "@i18n:nodes.system.input_generator.description",
      "adapter": "scheduler",
      "handler": "input_generator",
      "config": {},
      "schema": {
        "parameters": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "number",
                "float",
                "string",
                "text",
                "textarea",
                "boolean"
              ],
              "default": "string",
              "description": "Output type to emit."
            },
            "value": {
              "description": "Value to emit (interpreted according to the selected type)."
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": true
        },
        "results": {
          "type": "object",
          "properties": {
            "value": {
              "description": "Parsed value"
            },
            "raw": {
              "description": "Original input before parsing"
            },
            "type": {
              "type": "string",
              "description": "Type used for parsing"
            }
          },
          "additionalProperties": true
        }
      },
      "ui": {
        "inputPorts": [
          {
            "key": "type",
            "label": "@i18n:nodes.system.input_generator.inputPorts.type.label",
            "binding": {
              "path": "/parameters/type",
              "mode": "write"
            }
          },
          {
            "key": "input",
            "label": "@i18n:nodes.system.input_generator.inputPorts.input.label",
            "binding": {
              "path": "/parameters/value",
              "mode": "write"
            }
          }
        ],
        "outputPorts": [
          {
            "key": "value",
            "label": "@i18n:nodes.system.input_generator.outputPorts.value.label",
            "binding": {
              "path": "/results/value",
              "mode": "read"
            }
          },
          {
            "key": "raw",
            "label": "@i18n:nodes.system.input_generator.outputPorts.raw.label",
            "binding": {
              "path": "/results/raw",
              "mode": "read"
            }
          },
          {
            "key": "type",
            "label": "@i18n:nodes.system.input_generator.outputPorts.type.label",
            "binding": {
              "path": "/results/type",
              "mode": "read"
            }
          }
        ],
        "widgets": [
          {
            "key": "typedInput",
            "label": "@i18n:nodes.system.input_generator.widgets.typedInput.label",
            "component": "typed-input",
            "binding": {
              "path": "/parameters/value",
              "mode": "two_way"
            },
            "options": {
              "typePath": "/parameters/type",
              "options": [
                "number",
                "float",
                "string",
                "text",
                "textarea",
                "boolean"
              ]
            }
          }
        ]
      }
    },
    {
      "type": "system.upload_test",
      "status": "published",
      "category": "@i18n:nodes.system.upload_test.category",
      "label": "@i18n:nodes.system.upload_test.label",
      "description": "@i18n:nodes.system.upload_test.description",
      "tags": [
        "test",
        "uploads"
      ],
      "adapter": "scheduler",
      "handler": "upload_test",
      "config": {},
      "schema": {
        "parameters": {
          "type": "object",
          "properties": {
            "resources": {
              "type": "array",
              "description": "Uploaded resources selected in the UI.",
              "items": {
                "type": "object",
                "additionalProperties": true
              },
              "default": []
            }
          },
          "required": [],
          "additionalProperties": true
        },
        "results": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "description": "Number of uploaded resources."
            },
            "resourceIds": {
              "type": "array",
              "description": "Uploaded resource ids.",
              "items": {
                "type": "string"
              }
            },
            "filenames": {
              "type": "array",
              "description": "Uploaded filenames.",
              "items": {
                "type": "string"
              }
            },
            "sizes": {
              "type": "array",
              "description": "Uploaded file sizes.",
              "items": {
                "type": "integer"
              }
            },
            "resources": {
              "type": "array",
              "description": "Raw resource metadata.",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "ui": {
        "inputPorts": [
          {
            "key": "resources",
            "label": "@i18n:nodes.system.upload_test.inputPorts.resources.label",
            "binding": {
              "path": "/parameters/resources",
              "mode": "write"
            }
          }
        ],
        "outputPorts": [
          {
            "key": "count",
            "label": "@i18n:nodes.system.upload_test.outputPorts.count.label",
            "binding": {
              "path": "/results/count",
              "mode": "read"
            }
          },
          {
            "key": "resourceIds",
            "label": "@i18n:nodes.system.upload_test.outputPorts.resourceIds.label",
            "binding": {
              "path": "/results/resourceIds",
              "mode": "read"
            }
          }
        ],
        "widgets": [
          {
            "key": "uploads",
            "label": "@i18n:nodes.system.upload_test.widgets.uploads.label",
            "component": "file-upload",
            "binding": {
              "path": "/parameters/resources",
              "mode": "two_way"
            },
            "options": {
              "multiple": true,
              "maxFiles": 10,
              "maxBytes": 1073741824,
              "chunkParallel": 4,
              "maxParallel": 5,
              "providers": [
                "local"
              ],
              "provider": "local",
              "providerLabel": "Storage",
              "helperText": "Upload files to attach to this node (max 1 GB each).",
              "deleteOnRemove": true
            }
          },
          {
            "key": "count",
            "label": "@i18n:nodes.system.upload_test.widgets.count.label",
            "component": "number",
            "binding": {
              "path": "/results/count",
              "mode": "read"
            }
          },
          {
            "key": "resourceIds",
            "label": "@i18n:nodes.system.upload_test.widgets.resourceIds.label",
            "component": "json",
            "binding": {
              "path": "/results/resourceIds",
              "mode": "read"
            },
            "options": {
              "rows": 4
            }
          },
          {
            "key": "resources",
            "label": "@i18n:nodes.system.upload_test.widgets.resources.label",
            "component": "json",
            "binding": {
              "path": "/results/resources",
              "mode": "read"
            },
            "options": {
              "rows": 6
            }
          }
        ]
      }
    }
  ],
  "resources": [],
  "hooks": {
    "install": [],
    "uninstall": []
  }
}
